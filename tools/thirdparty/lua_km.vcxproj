    </ImportGroup>
    <PropertyGroup Label="UserMacros" />
    <PropertyGroup>
        <!-- Lua has no WPP trace macros; keep tracewpp off. -->
        <KsiNoWpp>true</KsiNoWpp>
        <!-- Vendored code; PREfast/analysis is not ours to fix. -->
        <RunCodeAnalysis>false</RunCodeAnalysis>
        <!-- RunCodeAnalysis=true is a global from the prefast leg and overrides the line above; this disables the analysis target. -->
        <EnableMicrosoftCodeAnalysis>false</EnableMicrosoftCodeAnalysis>
        <IntDir>$(SystemInformerRoot)KSystemInformer\obj\$(Configuration)$(PlatformArchitecture)\$(ProjectName)\</IntDir>
        <OutDir>$(SystemInformerRoot)KSystemInformer\bin\$(Configuration)$(PlatformArchitecture)\</OutDir>
        <TargetName>lua_km</TargetName>
    </PropertyGroup>
    <ItemDefinitionGroup>
        <ClCompile>
            <!-- Vendored code is not W4 clean (C4701, C4709, C4310, C4702). -->
            <WarningLevel>Level3</WarningLevel>
            <AdditionalIncludeDirectories>$(ProjectDir)lua\src\;$(ProjectDir)luaconfig\;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
            <!-- The Lua sources are the unmodified release; the configuration is forced in. -->
            <ForcedIncludeFiles>%(ForcedIncludeFiles);kphluaconf.h</ForcedIncludeFiles>
            <!-- Optimized in Debug too: unoptimized, the interpreter's frame is 3.7 KB per nested call and the kernel stack cannot carry Lua's nesting limit. -->
            <Optimization>MaxSpeed</Optimization>
            <IntrinsicFunctions>true</IntrinsicFunctions>
        </ClCompile>
    </ItemDefinitionGroup>
    <ItemGroup>
